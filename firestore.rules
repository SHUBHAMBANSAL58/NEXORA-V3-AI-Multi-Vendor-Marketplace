rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'bansalshubham662@gmail.com'
      );
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap: no resource/existing/diff inside validators)
    function isValidPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'tier', 'loyaltyPoints', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'tier', 'loyaltyPoints', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == userId
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.role is string
        && data.role in ['customer', 'seller']
        && data.tier is string
        && data.tier in ['Silver', 'Gold', 'Platinum']
        && data.loyaltyPoints is int
        && data.loyaltyPoints >= 0
        && data.loyaltyPoints <= 10000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'defaultPinCode', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == userId
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('defaultPinCode' in data) || (data.defaultPinCode is string && data.defaultPinCode.size() <= 16))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWishlistItem(data, userId, itemId) {
      return data.keys().hasAll(['uid', 'productId', 'productTitle', 'pricePaise', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'productId', 'productTitle', 'pricePaise', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == userId
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.productId is string
        && data.productId.size() >= 1
        && data.productId.size() <= 64
        && data.productId == itemId
        && data.productId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.productTitle is string
        && data.productTitle.size() >= 1
        && data.productTitle.size() <= 200
        && data.pricePaise is int
        && data.pricePaise >= 0
        && data.pricePaise <= 1000000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPriceAlert(data, userId, alertId) {
      return data.keys().hasAll(['uid', 'productId', 'productTitle', 'targetPricePaise', 'currentPricePaise', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'productId', 'productTitle', 'targetPricePaise', 'currentPricePaise', 'status', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == userId
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.productId is string
        && data.productId.size() >= 1
        && data.productId.size() <= 64
        && data.productId.matches('^[a-zA-Z0-9_\\-]+$')
        && isValidId(alertId)
        && data.productTitle is string
        && data.productTitle.size() >= 1
        && data.productTitle.size() <= 200
        && data.targetPricePaise is int
        && data.targetPricePaise >= 0
        && data.targetPricePaise <= 1000000000
        && data.currentPricePaise is int
        && data.currentPricePaise >= 0
        && data.currentPricePaise <= 1000000000
        && data.status is string
        && data.status in ['active', 'triggered', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Split-Collection User Profiles & Interaction Subcollections
    match /users/{userId}/public/{docId} {
      allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidId(docId)
        && docId == 'profile'
        && isValidPublicProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && (isOwner(userId) || isAdmin())
        && isValidId(userId)
        && isValidId(docId)
        && docId == 'profile'
        && isValidPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'tier', 'loyaltyPoints', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(docId);
    }

    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidId(docId)
        && docId == 'info'
        && isValidPrivateInfo(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && (isOwner(userId) || isAdmin())
        && isValidId(userId)
        && isValidId(docId)
        && docId == 'info'
        && isValidPrivateInfo(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'defaultPinCode', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(docId);
    }

    match /users/{userId}/wishlist/{itemId} {
      allow get: if isValidId(userId) && isValidId(itemId) && (isOwner(userId) || isAdmin());
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidId(itemId)
        && isValidWishlistItem(incoming(), userId, itemId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && (isOwner(userId) || isAdmin())
        && isValidId(userId)
        && isValidId(itemId)
        && isValidWishlistItem(incoming(), userId, itemId)
        && incoming().uid == existing().uid
        && incoming().productId == existing().productId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['productTitle', 'pricePaise', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(itemId);
    }

    match /users/{userId}/priceAlerts/{alertId} {
      allow get: if isValidId(userId) && isValidId(alertId) && (isOwner(userId) || isAdmin());
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidId(alertId)
        && isValidPriceAlert(incoming(), userId, alertId)
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && (isOwner(userId) || isAdmin())
        && isValidId(userId)
        && isValidId(alertId)
        && isValidPriceAlert(incoming(), userId, alertId)
        && incoming().uid == existing().uid
        && incoming().productId == existing().productId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && existing().status != 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['targetPricePaise', 'currentPricePaise', 'status', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(alertId);
    }

    // 5. Server-Managed Admin Directory (Read-Only from Client)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, create, update, delete: if false;
    }
  }
}
